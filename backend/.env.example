# Gere com: openssl rand -base64 32. Nunca use NEXT_PUBLIC_ para segredos.
JWT_SECRET=
API_HOST=127.0.0.1
API_PORT=3001
DATABASE_PATH=.data/portal.sqlite
# Origens exatas, separadas por vírgula, sem barra final nem curinga.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Seed apenas demonstrativo: defina explicitamente uma senha de 8 caracteres ou mais,
# com até 72 bytes UTF-8. O seed não redefine a senha de contas existentes.
SEED_PASSWORD=
